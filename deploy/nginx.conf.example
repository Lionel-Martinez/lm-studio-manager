# /etc/nginx/sites-available/panel.tudominio.com.ar
# Reemplazá panel.tudominio.com.ar y /var/www/lm-studio-manager por tus valores.
# Certbot completa el bloque de HTTPS (listen 443, certificados) y la redirección de HTTP.

server {
    listen 80;
    listen [::]:80;
    server_name panel.tudominio.com.ar;

    # Frontend (Vue compilado)
    root /var/www/lm-studio-manager/frontend/dist;
    index index.html;

    # Archivos con hash en el nombre: se pueden cachear mucho tiempo.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # API y chequeo de salud: Laravel (PHP-FPM)
    location ~ ^/(api|up)(/|$) {
        root /var/www/lm-studio-manager/backend/public;
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/lm-studio-manager/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/lm-studio-manager/backend/public;
        fastcgi_read_timeout 60s;
    }

    # Cualquier otra ruta es de la aplicación Vue (clientes, pagos, agenda...).
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }

    # Nunca servir archivos ocultos ni de configuración.
    location ~ /\.(?!well-known) { deny all; }

    client_max_body_size 2m;
    server_tokens off;
}
