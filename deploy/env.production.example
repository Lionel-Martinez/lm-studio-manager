# Copiar a backend/.env en el servidor y completar. NUNCA subir este archivo con datos reales a Git.
APP_NAME="LM Studio Client Manager"
APP_ENV=production
APP_KEY=                       # se genera con: php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://panel.tudominio.com.ar
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Argentina/Salta

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lm_studio_manager
DB_USERNAME=lm_manager          # usuario propio, NO root
DB_PASSWORD=                    # contraseña larga y única

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Solo si usás Cloudflare con la nube naranja delante del servidor:
TRUSTED_PROXIES=

BACKUP_KEEP=14
BACKUP_MYSQLDUMP_PATH=mysqldump
AUDIT_LOG_RETENTION_MONTHS=12

BUSINESS_NAME="LM Studio"
BUSINESS_TAX_ID=
BUSINESS_ADDRESS=
BUSINESS_CONTACT=
