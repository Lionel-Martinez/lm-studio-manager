# /etc/nginx/sites-available/lm-studio-api  (enlazar en sites-enabled)
# Reemplazá api.tudominio.com.ar y la ruta del proyecto. Certificado: certbot --nginx -d api.tudominio.com.ar

server {
    listen 80;
    server_name api.tudominio.com.ar;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.tudominio.com.ar;

    # certbot completa estas líneas:
    # ssl_certificate     /etc/letsencrypt/live/api.tudominio.com.ar/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.tudominio.com.ar/privkey.pem;

    root /var/www/lm-studio-manager/backend/public;
    index index.php;

    client_max_body_size 2m;
    server_tokens off;

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Nada oculto (.env, .git) se sirve jamás.
    location ~ /\.(?!well-known) {
        deny all;
    }
}
