{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LM Studio",
  "version": "0.1.0",
  "identifier": "ar.lmstudio.manager",
  "build": {
    "beforeBuildCommand": "npm run build-only -- --mode native",
    "beforeDevCommand": "npm run dev -- --mode native",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "LM Studio", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Business",
    "shortDescription": "Cuaderno de clientes de LM Studio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
